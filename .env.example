# Supabase — get these from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=XXXXXXXX
NEXT_PUBLIC_SUPABASE_ANON_KEY=XXXXXXXX
SUPABASE_SERVICE_ROLE_KEY=XXXXXXXX

# Supabase Postgres password — needed by CLI / migration tooling
SUPABASE_DATABASE_PASSWORD=XXXXXXXX

# Site URL — used for auth redirects and links in emails / Slack messages.
# NEXT_PUBLIC_SITE_URL is inlined at build time (local dev only); deployed
# environments must ALSO set SITE_URL as a runtime env var on Cloud Run —
# server code (src/lib/site-url.ts) reads SITE_URL first.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Studio plugin runtime. Plugins run on their own origin, which must be a different
# site from the app and never holds a session. Locally, 127.0.0.1 is a different site
# from localhost, so the same dev server plays both roles. Leave unset to turn plugin
# frames off. Production: a different registrable domain, over https.
# See docs/reference/studio-plugin-runtime.md.
STUDIO_RUNTIME_ORIGIN=http://127.0.0.1:3000
# Signs the short-lived tickets that let the runtime origin serve one frame. Server
# only, at least 32 characters. Generate one with: openssl rand -base64 48
STUDIO_FRAME_TICKET_SECRET=XXXXXXXX
# Students reach Studio plugins only when this is exactly "on". Server only. Keep it
# off in production until every item in the release gate passes:
# docs/reference/studio-plugin-publication.md#release-gate
STUDIO_STUDENT_ACCESS=off
# Runs the Studio validator's browser checks on this machine ("local"). Development only:
# it's refused when NODE_ENV is production, and unset means the browser checks can't run,
# so no plugin can pass. See docs/reference/studio-plugin-validator.md.
# STUDIO_VALIDATOR_RUNNER=local

# Resend email API key — get yours at https://resend.com/api-keys
# Free tier: 100 emails/day, 3000/month
RESEND_API_KEY=XXXXXXXX
EMAIL_FROM=Scholera <noreply@scholera-inc.com>

# Google Generative AI (Gemini) API key — https://aistudio.google.com/apikey
# Every AI feature in the app runs on this one key.
#
# This is the only variable name the app reads. The Vercel AI SDK's Google
# provider ignores GEMINI_API_KEY and GOOGLE_API_KEY, so a key set under either
# of those names looks configured and silently does nothing.
#
# The models pinned in src/lib/ai/config.ts are preview-tier: gemini-3-flash-preview,
# gemini-3.1-pro-preview, gemini-3.1-flash-lite-preview. A key without preview access
# gets 404 on every AI feature even though a hand-rolled curl against a stable model
# like gemini-2.5-flash succeeds. Confirm your key can see them before debugging
# anything else:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$KEY&pageSize=1000" | grep -o 'models/gemini-3[^"]*'
GOOGLE_GENERATIVE_AI_API_KEY=XXXXXXXX

# OpenAI API key — the app does not use it. Every AI feature runs on Gemini, and
# @ai-sdk/openai is installed but never imported. Two things outside src/ read it:
# Supabase Studio's built-in AI assistant (supabase/config.toml) and the optional
# OpenAI judge in the grounding eval (eval/grounding/judge.py). Leave it blank
# unless you want one of those.
OPENAI_API_KEY=

# Pinecone (serverless) — the vector database behind AI search, the student
# tutor's retrieval, and rubric reference lookup. Without these, those features
# throw "PINECONE_API_KEY is not set"; the rest of the app is unaffected.
# Keys live in the Pinecone console; ask the team for access.
#
# PINECONE_INDEX_MATERIALS names the index and doubles as the blue/green alias.
#
# There is ONE shared index across every environment, so a local `npm run dev`
# would upsert straight into the production namespace. Vector WRITES are therefore
# refused outside production and throw a message telling you this. Reads always
# work, so local search and retrieval need nothing extra. Set
# PINECONE_ALLOW_NONPROD_WRITES=true for one shell only when you are deliberately
# testing ingestion.
PINECONE_API_KEY=XXXXXXXX
PINECONE_INDEX_MATERIALS=XXXXXXXX
PINECONE_ALLOW_NONPROD_WRITES=

# Document Extraction v2 (vision-based PDF/PPT pipeline)
# EXTRACTION_WORKER_SECRET — shared secret the kick endpoint requires
# EXTRACTION_WORKER_KICK_URL — endpoint the upload flow pokes to start a worker run
# EXTRACTION_VISION_MAX_PAGES_PER_DOC — hard cap on pages processed per document
EXTRACTION_V2_ENABLED=true
EXTRACTION_WORKER_SECRET=XXXXXXXX
EXTRACTION_WORKER_KICK_URL=http://localhost:3000/api/extraction-worker/kick
EXTRACTION_VISION_MAX_PAGES_PER_DOC=200

# Athenamite background-jobs foundation (src/lib/jobs)
# BACKGROUND_JOBS_SECRET   — shared secret the /api/jobs-worker/kick route requires (distinct from the extraction secret)
# BACKGROUND_JOBS_KICK_URL — endpoint enqueueJob() + the jobs-sweep cron poke to run the worker
BACKGROUND_JOBS_SECRET=XXXXXXXX
BACKGROUND_JOBS_KICK_URL=http://localhost:3000/api/jobs-worker/kick

# Test Accounts
# NOTE: these accounts exist on the PRODUCTION Supabase project (institution
# "Scholera Dev"), not only locally — so their passwords are real credentials.
# Never put a working password in this file: it is committed, and anyone with
# repo read access could sign in with it. Keep the values in .env.local only.
# Re-seed anytime: npx tsx scripts/seed-test-users.ts
TEST_ADMIN_EMAIL=admin@scholera.dev
TEST_ADMIN_PASSWORD=<see .env.local — never commit a real password>

TEST_PROFESSOR_EMAIL=professor@scholera.dev
TEST_PROFESSOR_PASSWORD=<see .env.local — never commit a real password>

TEST_STUDENT_EMAIL=student@scholera.dev
TEST_STUDENT_PASSWORD=<see .env.local — never commit a real password>

# Test Team Members (Chat Testing) — All share TEST_TEAM_MEMBERS_PASSWORD
TEST_STUDENT2_EMAIL=emily.chen@scholera.dev
TEST_STUDENT2_NAME=Emily Chen
TEST_STUDENT3_EMAIL=marcus.johnson@scholera.dev
TEST_STUDENT3_NAME=Marcus Johnson
TEST_STUDENT4_EMAIL=priya.patel@scholera.dev
TEST_STUDENT4_NAME=Priya Patel
TEST_STUDENT5_EMAIL=alex.rodriguez@scholera.dev
TEST_STUDENT5_NAME=Alex Rodriguez
TEST_STUDENT6_EMAIL=jordan.kim@scholera.dev
TEST_STUDENT6_NAME=Jordan Kim
TEST_TEAM_MEMBERS_PASSWORD=<see .env.local — never commit a real password>

# ElevenLabs API key — used server-side for Scribe v2 real-time transcription
# tokens. Get yours at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=XXXXXXXX

# Gotenberg office converter (PPTX/PPT→PDF) — the app's ONLY office-conversion
# path since issue #182; LibreOffice is not in the app image. When UNSET,
# PowerPoint upload is disabled in the UI AND PPTX citation previews show
# "couldn't render"; PDF-only behavior is unchanged (graceful degradation).
# In prod, set this on the Cloud Run service to the converter's URL — see
# infra/microservices/deck-converter/README.md.
# Local dev: run `docker run --rm -p 3001:3000 gotenberg/gotenberg:8` and set
# GOTENBERG_URL=http://localhost:3001 plus GOTENBERG_SKIP_AUTH=true (port 3001 on
# the host because next dev already holds 3000).
GOTENBERG_URL=
GOTENBERG_SKIP_AUTH=true

# Slack incoming webhook used by infra/app/deploy-to-prod.sh for deploy pings.
SLACK_WEBHOOK_URL=XXXXXXXX

# Slack incoming webhook for the #issues channel — receives a notification
# every time a user submits feedback via the floating widget. Add a new
# webhook to the existing Scholera Slack app at https://api.slack.com/apps →
# Incoming Webhooks → Add New Webhook to Workspace, pointed at #issues.
# Pairs with SLACK_WEBHOOK_URL (used by infra/app/deploy-to-prod.sh for deploy
# pings) — same Slack app, different channels. When unset, feedback Slack
# notifications are skipped silently (feedback still saves to the DB).
SLACK_FEEDBACK_WEBHOOK_URL=XXXXXXXX

# Wolfram|Alpha app ID — powers the Solver block in the assignment studio.
# Get one at https://products.wolframalpha.com/api. Server-only, never
# NEXT_PUBLIC — src/lib/wolfram/client.ts throws if unset.
WOLFRAM_APP_ID=XXXXXXXX

# OneCompiler access token — runs student/professor code snippets server-side
# for the assignment studio's code blocks. Get one at https://onecompiler.com.
ONECOMPILER_ACCESS_TOKEN=XXXXXXXX

# Retrieval eval gate (eval/retrieval/, run via `npm run eval:retrieval`) — the
# seeded course it measures against. Local-only by design: the run refuses a
# non-local Supabase URL unless EVAL_ALLOW_REMOTE=1.
EVAL_SECTION_ID=
EVAL_INSTITUTION_ID=

# Hosted cross-encoder rerank for Athena's retrieval (student-qa-v1), via the
# Vertex AI Ranking API. ON BY DEFAULT — leave unset to get it. Set to 0 (or
# false) to turn it off, which also disables query decomposition and narrows the
# candidate pool back to 8.
#
# Turning it off is the lever for a cost freeze, a vendor incident, or an
# environment without the Discovery Engine grant. $1 per 1,000 messages.
#
# Auth is Application Default Credentials — the Cloud Run service account in
# prod, `gcloud auth application-default login` locally. No key file either way.
# Needs the Discovery Engine API enabled on the project and the caller granted
# roles/discoveryengine.user. Missing that grant is NOT fatal: the circuit
# breaker opens after 3 consecutive failures and serves the dense order, logging
# at error level so it is visible rather than silent.
RERANK_ENABLED=
GOOGLE_CLOUD_PROJECT=
