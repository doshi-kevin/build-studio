# Copy to .env.demo.local and fill in ONLY if you need a persistent local target
# that doesn't depend on `supabase status` detecting a live stack (e.g. a
# Supabase instance not started via the CLI). For the normal workflow you do
# NOT need this file — `bash scripts/demo/seed-demo.sh --local` finds a running
# local stack automatically and uses its live keys.
#
# This file is gitignored (.env*.local). Never put a real production URL here —
# seed-demo.sh trusts this file's URL as local without the typed confirmation
# prompt that a remote target gets.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
