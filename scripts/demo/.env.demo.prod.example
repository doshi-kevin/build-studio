# Copy to .env.demo.prod and fill in the REAL production values before running
# `bash scripts/demo/seed-demo.sh --prod`.
#
# This file is gitignored — never commit real production credentials.
#
# Filling this in does NOT make seeding happen. --prod only reads this file;
# seed-demo.sh still requires typing "Northcrest University" at an interactive
# prompt before it writes anything, and --reset requires typing "reset" on top
# of that. There is no flag that skips either prompt.

NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=XXXXXXXX
