{
  "name": "scholera-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:pre-merge": "npm run test:db && npm run e2e",
    "test:ui": "vitest --ui",
    "eval:retrieval": "dotenv -e .env.local -- tsx --tsconfig eval/tsconfig.json eval/retrieval/run.ts",
    "eval:preferences": "dotenv -e .env.local -- tsx --tsconfig eval/tsconfig.json eval/preference-adherence/run.ts",
    "eval:needles": "dotenv -e .env.local -- tsx --tsconfig eval/tsconfig.json eval/retrieval/needles-run.ts",
    "eval:needles:generate": "dotenv -e .env.local -- tsx --tsconfig eval/tsconfig.json eval/retrieval/generate-needles.ts",
    "eval:grounding": "dotenv -e .env.local -- tsx --tsconfig eval/tsconfig.json eval/grounding/export.ts",
    "db:seed:e2e": "dotenv -e .env.test -- tsx scripts/seed-e2e.ts",
    "e2e:prep": "bash scripts/e2e-prep-local.sh",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "e2e:studio-runtime": "playwright test --config=e2e/studio-runtime/playwright.config.ts",
    "e2e:studio-validator": "playwright test --config=e2e/studio-validator/playwright.config.ts"
  },
